# 이 파일을 복사해 .env를 만들고 값을 채우세요. (.env는 커밋되지 않습니다)

# ----- Database (docker-compose) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=doodok
DB_USERNAME=doodok
DB_PASSWORD=doodok

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379

# ----- JWT -----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=1209600

# ----- 외부 API -----
KAKAO_REST_API_KEY=
ALADIN_TTB_KEY=

# ----- AI -----
GEMINI_API_KEY=

# ----- AWS S3 -----
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ----- frontend -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
