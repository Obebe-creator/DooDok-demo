# 이 파일을 복사해 .env를 만들고 값을 채우세요. (.env는 커밋되지 않습니다)
#
# 누가 이 파일을 읽나
# - docker compose: 자동으로 읽는다. (DB, Redis, Mailpit 포트 등)
# - 백엔드(./gradlew bootRun): 자동으로 읽지 않는다. 셸 환경 변수와 application.yml 기본값을 쓴다.
#   로컬 기본값이 아래 값과 같아서 보통은 설정이 필요 없다. 바꾸려면 backend 폴더에서
#   `set -a; source ../.env; set +a` 후 bootRun을 실행한다. (README "2. 백엔드" 참고)
# - 프런트(Next.js): 이 파일을 읽지 않는다. frontend/.env.local을 쓴다.

# ----- Database (docker-compose) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=doodok
DB_USERNAME=doodok
DB_PASSWORD=doodok

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379

# ----- Mail -----
# 로컬은 Mailpit(인증 없음). 운영은 AWS SES SMTP 값으로 바꾼다.
#   MAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com, MAIL_PORT=587, MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@doodok.local

# ----- JWT -----
# 운영은 Base64로 인코딩된 최소 32바이트 키를 사용한다.
JWT_SECRET=

# ----- Frontend API access -----
# 운영은 HTTPS 프런트 Origin을 지정한다. 여러 개면 쉼표로 구분한다.
# 프런트와 API는 같은 사이트(doodok.xyz / api.doodok.xyz)에 둔다. Refresh 쿠키가 SameSite=Strict라
# 다른 사이트(예: *.vercel.app)에서는 쿠키가 전송되지 않는다.
# CORS_ALLOWED_ORIGINS=https://doodok.xyz
# API_DOCS_ENABLED=false

# ----- Reverse proxy (선택) -----
# 신뢰할 수 있는 프록시 뒤에서만 native와 프록시 주소의 정규식을 설정한다.
FORWARD_HEADERS_STRATEGY=none
# TRUSTED_PROXY_PATTERN=

# ----- 외부 API -----
KAKAO_REST_API_KEY=
ALADIN_TTB_KEY=

# ----- AI -----
GEMINI_API_KEY=

# ----- AWS S3 -----
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ----- frontend -----
# 이 값은 루트 .env가 아니라 frontend/.env.local에 적어야 Next.js가 읽는다. (참고용)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
